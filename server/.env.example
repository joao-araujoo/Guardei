PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE
AUTH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# IA. Sem chave, classificacao, embeddings e varias funcoes continuam com fallback local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Gere uma vez com: npm --prefix server run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@dominio.com

# Scheduler interno para notificacoes inteligentes
PUSH_SCHEDULER_ENABLED=true
PUSH_SCHEDULER_INTERVAL_MINUTES=60

# Digest semanal inteligente. O scheduler verifica periodicamente quem esta elegivel.
DIGEST_SCHEDULER_ENABLED=true

# Opcional: use um cron externo chamando POST /api/push/cron
# com o header X-Push-Cron-Secret.
PUSH_CRON_SECRET=troque-por-um-segredo-longo

# WhatsApp Cloud API (Meta). Sem estas variaveis, o restante do Guardei funciona normalmente.
# O webhook publico deve apontar para: /api/integrations/whatsapp
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-de-verificacao
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
