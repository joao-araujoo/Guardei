generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum VideoStatus {
  inbox
  novo
  rever
  importante
  aplicado
  arquivado
}

enum VideoPriority {
  baixa
  media
  alta
}

model Video {
  id                String        @id @default(cuid())
  userId            String?
  url               String
  canonicalUrl      String?
  platform          String        @default("web")
  platformLabel     String?
  videoId           String?
  tiktokId          String?
  titleOriginal     String?
  titleAi           String
  titleCustom       String?
  authorName        String?
  authorUrl         String?
  thumbnailUrl      String?
  thumbnailFallback String?
  providerName      String?
  description       String?
  category          String
  reason            String
  tags              String[]
  priority          VideoPriority @default(baixa)
  status            VideoStatus   @default(novo)
  note              String?
  summary           String?
  mood              String?
  effort            String?
  durationBucket    String?
  bestFor           String?
  watchWhen         String?
  sourceText        String?
  origin            String        @default("manual")
  reviewCount       Int           @default(0)
  schemaVersion     Int           @default(3)
  aiEngine          String?
  aiConfidence      Float?
  aiRationale       String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions         VideoRevision[]

  @@unique([userId, url])
  @@index([userId])
  @@index([category])
  @@index([platform])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  videos       Video[]
  settings     UserSettings?
}

model UserSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  dailyReviewTarget          Int      @default(3)
  autoOpenReviewAfterShare   Boolean  @default(false)
  storageMode                String   @default("api")
  backendReady               Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VideoRevision {
  id        String   @id @default(cuid())
  videoId   String
  status    String
  note      String?
  action    String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([createdAt])
}
