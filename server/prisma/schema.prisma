generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum VideoStatus {
  inbox
  novo
  rever
  importante
  aplicado
  arquivado
}

enum VideoPriority {
  baixa
  media
  alta
}

enum CapsuleStatus {
  idle
  extracting
  generating
  completed
  limited
  failed
}

enum CapsuleCoverage {
  full_content
  user_content
  metadata_only
  partial_content
}

model Video {
  id                String        @id @default(cuid())
  userId            String?
  url               String
  canonicalUrl      String?
  platform          String        @default("web")
  platformLabel     String?
  videoId           String?
  tiktokId          String?
  titleOriginal     String?
  titleAi           String
  titleCustom       String?
  authorName        String?
  authorUrl         String?
  thumbnailUrl      String?
  thumbnailFallback String?
  providerName      String?
  description       String?
  category          String
  reason            String
  tags              String[]
  priority          VideoPriority @default(baixa)
  status            VideoStatus   @default(novo)
  note              String?
  summary           String?
  mood              String?
  effort            String?
  durationBucket    String?
  bestFor           String?
  watchWhen         String?
  sourceName        String?
  watchedAt         DateTime?
  watchedSeconds    Int           @default(0)
  watchCount        Int           @default(0)
  sourceText        String?
  origin            String        @default("manual")
  reviewCount       Int           @default(0)
  schemaVersion     Int           @default(3)
  aiEngine          String?
  aiConfidence      Float?
  aiRationale       String?
  reviewedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions         VideoRevision[]
  capsule           ContentCapsule?

  @@unique([userId, url])
  @@index([userId])
  @@index([category])
  @@index([platform])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model User {
  id           String        @id @default(cuid())
  name         String?
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  videos       Video[]
  settings     UserSettings?
  achievements UserAchievement[]
  capsules     ContentCapsule[]
}

model UserSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  dailyReviewTarget          Int      @default(3)
  autoOpenReviewAfterShare   Boolean  @default(false)
  storageMode                String   @default("api")
  backendReady               Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VideoRevision {
  id        String   @id @default(cuid())
  videoId   String
  status    String
  note      String?
  action    String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([createdAt])
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}


model ContentCapsule {
  id                    String          @id @default(cuid())
  userId                String
  videoId               String          @unique
  status                CapsuleStatus   @default(idle)
  coverage              CapsuleCoverage @default(metadata_only)
  language              String          @default("pt-BR")
  summary               String?
  keyPoints             Json            @default("[]")
  concepts              Json            @default("[]")
  practicalApplications Json            @default("[]")
  actionItems           Json            @default("[]")
  reflectionQuestions   Json            @default("[]")
  evidenceSnippets      Json            @default("[]")
  sourceText            String?
  sourceTextHash        String?
  aiModel               String?
  aiConfidence          Float?
  aiRationale           String?
  errorCode             String?
  errorMessage          String?
  generatedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  video                 Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, coverage])
  @@index([generatedAt])
  @@index([userId, generatedAt])
}
