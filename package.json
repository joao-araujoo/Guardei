{
  "name": "guardei",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "render:build": "npm run build && npm ci --prefix server --no-audit --no-fund && npm --prefix server run db:generate && npm --prefix server run db:migrate:deploy",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "vite": "8.2.2"
  }
}
