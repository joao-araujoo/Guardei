{
  "name": "tiktok-vault-auto",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "render:build": "npm run build && npm install --prefix server && npm --prefix server run db:generate && npm --prefix server run db:push",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "@google/genai": "^2.5.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  }
}
