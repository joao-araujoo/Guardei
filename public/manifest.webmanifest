{
  "id": "/",
  "name": "Guardei - Acervo com IA",
  "short_name": "Guardei",
  "description": "Salve qualquer link da internet, organize seu acervo e receba recomendações inteligentes do Guardinho para revisitar o que importa.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f6edd8",
  "theme_color": "#f6edd8",
  "categories": ["productivity", "utilities", "lifestyle"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/icons/guardei-icon.png",
      "sizes": "1254x1254",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/guardei-icon-transparent.png",
      "sizes": "1254x1254",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/?share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Guardar link copiado",
      "short_name": "Guardar",
      "description": "Abrir o Guardinho e detectar o link que está no clipboard.",
      "url": "/?clipboard=1",
      "icons": [{ "src": "/icons/guardei-icon.png", "sizes": "1254x1254", "type": "image/png" }]
    },
    {
      "name": "Adicionar link",
      "short_name": "Adicionar",
      "description": "Abrir direto na tela de salvamento.",
      "url": "/?add=1",
      "icons": [{ "src": "/icons/guardei-icon.png", "sizes": "1254x1254", "type": "image/png" }]
    },
    {
      "name": "Revisão rápida",
      "short_name": "Revisar",
      "description": "Abrir itens para revisar.",
      "url": "/?review=1",
      "icons": [{ "src": "/icons/guardei-icon.png", "sizes": "1254x1254", "type": "image/png" }]
    }
  ]
}
